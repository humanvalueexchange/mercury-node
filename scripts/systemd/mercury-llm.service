[Unit]
Description=Mercury Local LLM (Qwen3.8-2B native llama.cpp)
After=network.target
PartOf=mercury-agent.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=mercury-llm
Group=mercury-llm
CPUAffinity=2 3
Environment=LD_LIBRARY_PATH=/opt/mercury/llama.cpp/lib
ExecStart=/opt/mercury/llama.cpp/bin/llama-server \
  -m /opt/mercury/models/Qwen3.8-2B-Distill-Q4_K_M.gguf \
  --host 127.0.0.1 \
  --port 8089 \
  --ctx-size 8192 \
  --threads 2 \
  --reasoning off
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
