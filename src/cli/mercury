# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="mercury",
        description="Mercury Node — sovereign Bitcoin Lightning node CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("status",   help="Node health at a glance")
    sub.add_parser("sync",     help="Bitcoin sync progress")
    sub.add_parser("peers",    help="Connected peers")
    sub.add_parser("backup",   help="Export static channel backup")
    sub.add_parser("version",  help="Version info")

    sub.add_parser("channels", help="Lightning channel overview")

    inv_p = sub.add_parser("invoices", help="Recent payments")
    inv_p.add_argument("--last", type=int, default=10, metavar="N", help="Show last N invoices")

    log_p = sub.add_parser("logs", help="Live log tail")
    log_p.add_argument("service", nargs="?", default="lnd",
                       help="Service: lnd, bitcoind, btcpayserver, nbxplorer, nginx, mercury-agent")

    pay_p = sub.add_parser("pay", help="Send a Lightning payment")
    pay_p.add_argument("bolt11", help="BOLT11 invoice string")

