# ANSI colors
R   = "\033[0;31m"
Y   = "\033[1;33m"
G   = "\033[0;32m"
B   = "\033[0;34m"
C   = "\033[0;36m"
W   = "\033[1;37m"
DIM = "\033[2m"
NC  = "\033[0m"

# ── LND wrapper ───────────────────────────────────────────────────────────────

def lncli(*args, timeout=15):
    """Run lncli command, return parsed JSON or raise."""
    cmd = ["sudo", "-u", LND_USER, "lncli", f"--lnddir={LND_DIR}"] + list(args)
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout
        )
        if result.returncode != 0:
            return None, result.stderr.strip()
        return json.loads(result.stdout), None
    except subprocess.TimeoutExpired:
        return None, "timeout"
    except json.JSONDecodeError as e:
        return None, f"json error: {e}"
    except Exception as e:
        return None, str(e)


def systemctl_is_active(service):
    try:
        r = subprocess.run(
            ["systemctl", "is-active", service],
            capture_output=True, text=True, timeout=5
        )
        return r.stdout.strip() == "active"
    except Exception:
        return False


def get_uptime():
    try:
        with open("/proc/uptime") as f:
            secs = float(f.read().split()[0])
        d = int(secs // 86400)
        h = int((secs % 86400) // 3600)
        m = int((secs % 3600) // 60)
        if d > 0:
            return f"{d}d {h}h {m}m"
        elif h > 0:
            return f"{h}h {m}m"
        else:
            return f"{m}m"
    except Exception:
        return "unknown"


# ── Formatters ────────────────────────────────────────────────────────────────

def fmt_sat(n):
    """Format satoshi amount with comma separators."""
    return f"{int(n):,} SAT"


def fmt_pct(local, capacity):
    """Return balance percentage and colored indicator."""
    if capacity == 0:
        return 0, Y
    pct = int(local) / int(capacity) * 100
    if 20 <= pct <= 80:
        color = G
    elif 10 <= pct < 20 or 80 < pct <= 90:
        color = Y
    else:
        color = R
    return pct, color


def bar(pct, width=20):
    """ASCII balance bar."""
    filled = int(pct / 100 * width)
    return f"[{'█' * filled}{'░' * (width - filled)}]"


def service_dot(active):
    return f"{G}●{NC}" if active else f"{R}●{NC}"


# ── Commands ──────────────────────────────────────────────────────────────────

def cmd_status(args):
    info, err = lncli("getinfo")
    wallet, _ = lncli("walletbalance")
    channels, _ = lncli("listchannels")

    services = {
        "bitcoind": systemctl_is_active("bitcoind"),
        "lnd":      systemctl_is_active("lnd"),
        "btcpay":   systemctl_is_active("btcpayserver"),
        "nbxplorer":systemctl_is_active("nbxplorer"),
        "nginx":    systemctl_is_active("nginx"),
    }
    all_ok = all(services.values())
    node_ok = info is not None and info.get("synced_to_chain", False)

    # Header
    status_icon = f"{G}🟢{NC}" if (all_ok and node_ok) else f"{Y}🟡{NC}" if node_ok else f"{R}🔴{NC}"
    print(f"\n{status_icon} {W}Mercury Node v{MERCURY_VERSION}{NC}")
    print(f"{DIM}{'─' * 45}{NC}")

    # Node info
    if info:
        alias = info.get("alias", "unknown")
        block = info.get("block_height", 0)
        synced = info.get("synced_to_chain", False)
        sync_icon = f"{G}✅{NC}" if synced else f"{Y}syncing...{NC}"
        num_ch = info.get("num_active_channels", 0)
        num_pending = info.get("num_pending_channels", 0)
        print(f"  {DIM}Node    {NC} {W}{alias}{NC}")
        print(f"  {DIM}Network {NC} mainnet | block {block:,} {sync_icon}")
        print(f"  {DIM}Pubkey  {NC} {DIM}{info.get('identity_pubkey', '')[:32]}...{NC}")
    else:
        print(f"  {R}LND unavailable — run: sudo systemctl status lnd{NC}")

    # Wallet
    if wallet:
        confirmed = int(wallet.get("confirmed_balance", 0))
        unconfirmed = int(wallet.get("unconfirmed_balance", 0))
        locked = int(wallet.get("locked_balance", 0))
        print(f"  {DIM}Wallet  {NC} {W}{fmt_sat(confirmed)}{NC} confirmed", end="")
        if unconfirmed > 0:
            print(f"  {Y}+{fmt_sat(unconfirmed)} pending{NC}", end="")
        print()
        if locked > 0:
            print(f"  {DIM}Locked  {NC} {DIM}{fmt_sat(locked)} (channels){NC}")

    # Channels summary
    if channels:
        ch_list = channels.get("channels", [])
        active = [c for c in ch_list if c.get("active")]
        if active:
            avg_pct = sum(int(c["local_balance"]) / int(c["capacity"]) * 100 for c in active) / len(active)
            pct_color = G if 30 <= avg_pct <= 70 else Y
            print(f"  {DIM}Channels{NC} {W}{len(active)} active{NC} | avg balance {pct_color}{avg_pct:.0f}%{NC}", end="")
            if num_pending > 0:
                print(f" {Y}({num_pending} pending){NC}", end="")
            print()
        else:
            print(f"  {DIM}Channels{NC} {Y}0 active{NC}", end="")
            if num_pending > 0:
                print(f" {Y}({num_pending} pending — awaiting confirmation){NC}", end="")
            print()

    # Services
    svc_line = "  " + "  ".join(
        f"{service_dot(v)} {k}" for k, v in services.items()
    )
    print(f"\n{svc_line}")

    # Uptime
    print(f"  {DIM}Uptime   {NC} {get_uptime()}")
    print(f"{DIM}{'─' * 45}{NC}\n")


def cmd_channels(args):
    channels, err = lncli("listchannels")
    pending, _ = lncli("pendingchannels")

    print(f"\n{W}Lightning Channels{NC}")
    print(f"{DIM}{'─' * 55}{NC}")

    if channels:
        ch_list = channels.get("channels", [])
        if not ch_list:
            print(f"  {Y}No active channels.{NC}")
        else:
            for c in ch_list:
                local = int(c["local_balance"])
                capacity = int(c["capacity"])
                remote = int(c["remote_balance"])
                pct, color = fmt_pct(local, capacity)
                active = c.get("active", False)
                peer = c.get("remote_pubkey", "")[:20] + "..."
                alias_info, _ = lncli("getnodeinfo", f"--pub_key={c['remote_pubkey']}")
                alias = alias_info.get("node", {}).get("alias", peer) if alias_info else peer

                dot = f"{G}●{NC}" if active else f"{R}●{NC}"
                b = bar(pct)
                print(f"\n  {dot} {W}{alias}{NC}")
                print(f"     {color}{b}{NC} {pct:.0f}%")
                print(f"     Local {color}{fmt_sat(local)}{NC}  Remote {DIM}{fmt_sat(remote)}{NC}  Cap {DIM}{fmt_sat(capacity)}{NC}")
                if pct < 20:
                    print(f"     {Y}⚠ Low outbound — consider rebalancing{NC}")
                elif pct > 80:
                    print(f"     {Y}⚠ Low inbound — consider rebalancing{NC}")

    # Pending channels
    if pending:
        pending_open = pending.get("pending_open_channels", [])
        if pending_open:
            print(f"\n  {Y}Pending ({len(pending_open)}){NC}")
            for p in pending_open:
                ch = p.get("channel", {})
                local = int(ch.get("local_balance", 0))
                capacity = int(ch.get("capacity", 0))
                peer = ch.get("remote_node_pub", "")[:20] + "..."
                print(f"  {Y}⏳{NC} {peer}  {fmt_sat(local)} / {fmt_sat(capacity)}  {DIM}(awaiting 3 confirmations){NC}")

    print(f"\n{DIM}{'─' * 55}{NC}\n")


def cmd_invoices(args):
    n = getattr(args, 'last', 10)
    data, err = lncli("listinvoices", "--reversed", f"--num_max_invoices={n}")

    print(f"\n{W}Recent Invoices{NC} {DIM}(last {n}){NC}")
    print(f"{DIM}{'─' * 55}{NC}")

    if not data:
        print(f"  {R}Could not fetch invoices{NC}")
        return

    invoices = data.get("invoices", [])
    if not invoices:
        print(f"  {DIM}No invoices yet.{NC}")
    else:
        for inv in invoices:
            state = inv.get("state", "UNKNOWN")
            amt = int(inv.get("value", 0))
            memo = inv.get("memo", "") or DIM + "(no memo)" + NC
            settled_at = inv.get("settle_date", "0")

            if state == "SETTLED":
                icon = f"{G}✅{NC}"
                ts = datetime.fromtimestamp(int(settled_at), tz=timezone.utc).strftime("%Y-%m-%d %H:%M")
                color = G
            elif state == "OPEN":
                icon = f"{Y}⏳{NC}"
                ts = "pending"
                color = Y
            else:
                icon = f"{DIM}✗{NC}"
                ts = "expired"
                color = DIM

            print(f"  {icon} {color}{fmt_sat(amt)}{NC}  {DIM}{ts}{NC}  {memo}")

    print(f"\n{DIM}{'─' * 55}{NC}\n")


