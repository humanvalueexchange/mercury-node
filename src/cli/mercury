        print(f"  Use: mercury magma [offers|score|recommend]")

    print(f"{DIM}{'─' * 55}{NC}\n")


def _build_node_context():
    """Collect live node telemetry for AI context."""
    info, _     = lncli("getinfo")
    wallet, _   = lncli("walletbalance")
    channels, _ = lncli("listchannels")
    pending, _  = lncli("pendingchannels")
    ctx = ""
    if info:
        ctx += f"Node alias: {info.get('alias')}\n"
        ctx += f"Block height: {info.get('block_height')}, synced: {info.get('synced_to_chain')}\n"
        ctx += f"Active channels: {info.get('num_active_channels')}, pending: {info.get('num_pending_channels')}\n"
    if wallet:
        ctx += f"Wallet: {wallet.get('confirmed_balance')} SAT confirmed, {wallet.get('unconfirmed_balance')} SAT pending\n"
    if channels:
        for c in channels.get("channels", []):
            local = int(c["local_balance"])
            cap   = int(c["capacity"])
            pct   = round(local/cap*100, 1) if cap else 0
            ctx += f"Channel: local {local} SAT / capacity {cap} SAT ({pct}% local)\n"
    if pending:
        for p in pending.get("pending_open_channels", []):
            ch = p.get("channel", {})
            ctx += f"Pending channel: {ch.get('local_balance')} SAT / {ch.get('capacity')} SAT (awaiting confirmation)\n"
    return ctx


def _ask_dgx(question, system_prompt):
    """Stream answer from DGX Ollama. Returns True on success, False if unreachable."""
    payload = json.dumps({
        "model": OLLAMA_MODEL,
        "prompt": question,
        "system": system_prompt,
        "stream": True,
    }).encode()
    try:
        req = urllib.request.Request(
            f"{OLLAMA_URL}/api/generate",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        print(f"  {G}A:{NC} ", end="", flush=True)
        with urllib.request.urlopen(req, timeout=60) as r:
            for line in r:
                chunk = json.loads(line.decode())
                print(chunk.get("response", ""), end="", flush=True)
                if chunk.get("done"):
                    break
        print(f"\n")
        return True
    except urllib.error.URLError:
        return False


def _ask_local(question, system_prompt):
    """Stream answer from local Qwen2.5-3B via llama.cpp OpenAI-compatible server."""
    payload = json.dumps({
        "model": "phi-3.5-mini",
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user",   "content": question},
        ],
        "stream": True,
        "max_tokens": 512,
    }).encode()
    try:
        req = urllib.request.Request(
            f"{LOCAL_LLM_URL}/v1/chat/completions",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        print(f"  {G}A:{NC} ", end="", flush=True)
        with urllib.request.urlopen(req, timeout=120) as r:
            for line in r:
                line = line.decode().strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    chunk = json.loads(data)
                    token = chunk.get("choices", [{}])[0].get("delta", {}).get("content", "")
                    print(token, end="", flush=True)
                except (json.JSONDecodeError, IndexError, KeyError):
                    pass
        print(f"\n")
        return True
    except urllib.error.URLError as e:
        print(f"\n  {R}Local LLM also unreachable: {e}{NC}")
        print(f"  {DIM}Start it with: sudo systemctl start mercury-llm{NC}\n")
        return False


def cmd_ask(args):
    question = " ".join(args.question)
    node_ctx = _build_node_context()
    system_prompt = (
        "You are Mercury, an AI agent living inside a sovereign Bitcoin Lightning node "
        "operated by Human Value Exchange (HVE). You have real-time access to the node's "
        "telemetry. Answer concisely and practically. Always think in SATs. "
