        "invoices": cmd_invoices,
        "sync":     cmd_sync,
        "peers":    cmd_peers,
        "backup":   cmd_backup,
        "logs":     cmd_logs,
        "pay":      cmd_pay,
        "invoice":  cmd_invoice,
        "magma":    cmd_magma,
        "ask":      cmd_ask,
        "version":  cmd_version,
    }

    if args.command in dispatch:
        try:
            dispatch[args.command](args)
        except KeyboardInterrupt:
            print()
