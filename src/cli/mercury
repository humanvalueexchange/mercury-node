        print(f"  Use: mercury magma [offers|score|recommend]")

    print(f"{DIM}{'─' * 55}{NC}\n")


def _build_node_context():
    """Collect live node telemetry for AI context."""
    info, _     = lncli("getinfo")
    wallet, _   = lncli("walletbalance")
    channels, _ = lncli("listchannels")
    pending, _  = lncli("pendingchannels")
    ctx = ""
    if info:
        ctx += f"Node alias: {info.get('alias')}\n"
        ctx += f"Block height: {info.get('block_height')}, synced: {info.get('synced_to_chain')}\n"
        ctx += f"Active channels: {info.get('num_active_channels')}, pending: {info.get('num_pending_channels')}\n"
    if wallet:
        ctx += f"Wallet: {wallet.get('confirmed_balance')} SAT confirmed, {wallet.get('unconfirmed_balance')} SAT pending\n"
    if channels:
        for c in channels.get("channels", []):
            local = int(c["local_balance"])
            cap   = int(c["capacity"])
            pct   = round(local/cap*100, 1) if cap else 0
            ctx += f"Channel: local {local} SAT / capacity {cap} SAT ({pct}% local)\n"
    if pending:
        for p in pending.get("pending_open_channels", []):
            ch = p.get("channel", {})
            ctx += f"Pending channel: {ch.get('local_balance')} SAT / {ch.get('capacity')} SAT (awaiting confirmation)\n"
    return ctx


def _ask_dgx(question, system_prompt):
    """Stream answer from DGX Ollama. Returns True on success, False if unreachable."""
    payload = json.dumps({
        "model": OLLAMA_MODEL,
        "prompt": question,
        "system": system_prompt,
        "stream": True,
    }).encode()
    try:
        req = urllib.request.Request(
            f"{OLLAMA_URL}/api/generate",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        print(f"  {G}A:{NC} ", end="", flush=True)
        with urllib.request.urlopen(req, timeout=60) as r:
            for line in r:
                chunk = json.loads(line.decode())
                print(chunk.get("response", ""), end="", flush=True)
                if chunk.get("done"):
                    break
        print(f"\n")
        return True
    except urllib.error.URLError:
        return False


def _ask_local(question, system_prompt):
    """Stream answer from local Phi-3.5-mini via llama.cpp OpenAI-compatible server."""
    payload = json.dumps({
        "model": "phi-3.5-mini",
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user",   "content": question},
        ],
        "stream": True,
        "max_tokens": 512,
    }).encode()
    try:
        req = urllib.request.Request(
            f"{LOCAL_LLM_URL}/v1/chat/completions",
            data=payload,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        print(f"  {G}A:{NC} ", end="", flush=True)
        with urllib.request.urlopen(req, timeout=120) as r:
            for line in r:
                line = line.decode().strip()
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    chunk = json.loads(data)
                    token = chunk.get("choices", [{}])[0].get("delta", {}).get("content", "")
                    print(token, end="", flush=True)
                except (json.JSONDecodeError, IndexError, KeyError):
                    pass
        print(f"\n")
        return True
    except urllib.error.URLError as e:
        print(f"\n  {R}Local LLM also unreachable: {e}{NC}")
        print(f"  {DIM}Start it with: sudo systemctl start mercury-llm{NC}\n")
        return False


def cmd_ask(args):
    question = " ".join(args.question)
    node_ctx = _build_node_context()
    system_prompt = (
        "You are Mercury, an AI agent living inside a sovereign Bitcoin Lightning node "
        "operated by Human Value Exchange (HVE). You have real-time access to the node's "
        "telemetry. Answer concisely and practically. Always think in SATs. "
        "Recommend actions when useful but note that human approval is required before any funds move.\n"
        "Current node data:\n" + node_ctx
    )

    # Try DGX Spark first (fast, powerful)
    dgx_ok = False
    try:
        urllib.request.urlopen(f"{OLLAMA_URL}/api/tags", timeout=3)
        dgx_ok = True
    except urllib.error.URLError:
        pass

    if dgx_ok:
        print(f"\n{C}🤖 Mercury AI{NC}  {DIM}(DGX Spark — {OLLAMA_MODEL}){NC}")
        print(f"{DIM}{'─' * 55}{NC}")
        print(f"  {W}Q:{NC} {question}\n")
        if _ask_dgx(question, system_prompt):
            return

    # Fall back to local Phi-3.5-mini on Pi
    print(f"\n{C}🤖 Mercury AI{NC}  {DIM}(Local — Phi-3.5-mini){NC}")
    print(f"{DIM}{'─' * 55}{NC}")
    print(f"  {W}Q:{NC} {question}\n")
    if not dgx_ok:
        print(f"  {Y}DGX unreachable — using local Phi-3.5-mini{NC}\n")
    _ask_local(question, system_prompt)


def cmd_version(args):
    info, _ = lncli("getinfo")
    lnd_ver = info.get("version", "unknown") if info else "unavailable"
    print(f"\n  Mercury Node  v{MERCURY_VERSION}")
    print(f"  LND           {lnd_ver}")
    print(f"  Python        {sys.version.split()[0]}\n")


def cmd_shell(args=None):
    """
    Interactive Mercury session.
    Type naturally — anything that isn't a command is sent to Mercury AI.
    Commands: status channels invoices sync peers backup logs pay invoice magma version exit
    """
    import shlex

    COMMANDS = {"status", "channels", "invoices", "sync", "peers",
                "backup", "logs", "pay", "invoice", "magma", "version", "help", "exit", "quit"}

    dispatch = {
        "status":   cmd_status,
        "channels": cmd_channels,
        "invoices": cmd_invoices,
        "sync":     cmd_sync,
        "peers":    cmd_peers,
        "backup":   cmd_backup,
        "logs":     cmd_logs,
        "pay":      cmd_pay,
        "invoice":  cmd_invoice,
        "magma":    cmd_magma,
        "version":  cmd_version,
    }

    # Show brief status on entry
    print(f"\n{C}⚡ Mercury Node  v{MERCURY_VERSION}{NC}  {DIM}— sovereign Bitcoin Lightning node{NC}")
    print(f"{DIM}Type naturally to talk to Mercury AI, or use commands: status channels magma invoices ...{NC}")
    print(f"{DIM}Type 'exit' or press Ctrl+D to quit.{NC}\n")

    # Quick status flash on entry
    try:
        data, err = _agent_get("/api/status")
        if data and not err:
            wallet = data.get("wallet", {})
            chans  = data.get("channels", {})
            bal    = wallet.get("confirmed_sat", 0)
            active = chans.get("active", 0)
            pending = chans.get("pending", 0)
            block  = data.get("node", {}).get("block_height", "?")
            chan_str = f"{active} active" + (f", {pending} pending" if pending else "")
            print(f"  {G}●{NC} {W}{fmt_sat(bal)}{NC}  |  {chan_str}  |  block {block}\n")
    except Exception:
        pass

    while True:
        try:
            line = input(f"{G}⚡{NC} ").strip()
        except (EOFError, KeyboardInterrupt):
            print(f"\n{DIM}Goodbye.{NC}\n")
            break

        if not line:
            continue

        if line.lower() in ("exit", "quit", "bye"):
            print(f"\n{DIM}Goodbye.{NC}\n")
            break

        if line.lower() == "help":
            print(f"\n  {W}Commands:{NC}  status  channels  invoices  sync  peers  backup  logs")
            print(f"             pay <bolt11>  invoice <sat> [memo]")
            print(f"             magma [offers|score|recommend]  version  exit")
            print(f"  {W}Or just type naturally{NC} — anything else goes to Mercury AI.\n")
            continue

        try:
            parts = shlex.split(line)
        except ValueError:
            parts = line.split()

        cmd = parts[0].lower() if parts else ""
        rest = parts[1:]

        if cmd not in COMMANDS:
            # Natural language → AI
            ns = argparse.Namespace(question=line.split())
            try:
                cmd_ask(ns)
            except KeyboardInterrupt:
                print()
            continue

        if cmd in ("exit", "quit"):
            print(f"\n{DIM}Goodbye.{NC}\n")
            break

        ns = argparse.Namespace(command=cmd)
        try:
            if cmd == "invoices":
                ns.last = int(rest[0]) if rest else 10
            elif cmd == "logs":
                ns.service = rest[0] if rest else "lnd"
            elif cmd == "pay":
                if not rest:
                    print(f"  {Y}Usage: pay <bolt11>{NC}")
                    continue
                ns.bolt11 = rest[0]
            elif cmd == "invoice":
                if not rest:
                    print(f"  {Y}Usage: invoice <sat> [memo]{NC}")
                    continue
                ns.sat = int(rest[0])
                ns.memo = " ".join(rest[1:]) if len(rest) > 1 else ""
            elif cmd == "magma":
                ns.subcmd = rest[0] if rest else "offers"
                ns.min_sat = 100000
                ns.max_sat = 5000000
        except (ValueError, IndexError) as e:
            print(f"  {R}Argument error: {e}{NC}")
            continue

        try:
            dispatch[cmd](ns)
        except KeyboardInterrupt:
            print()


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        prog="mercury",
        description="Mercury Node — sovereign Bitcoin Lightning node CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("shell",    help="Interactive shell (no 'mercury' prefix needed)")
    sub.add_parser("status",   help="Node health at a glance")
    sub.add_parser("sync",     help="Bitcoin sync progress")
    sub.add_parser("peers",    help="Connected peers")
    sub.add_parser("backup",   help="Export static channel backup")
    sub.add_parser("version",  help="Version info")

    sub.add_parser("channels", help="Lightning channel overview")

    inv_p = sub.add_parser("invoices", help="Recent payments")
    inv_p.add_argument("--last", type=int, default=10, metavar="N", help="Show last N invoices")

    log_p = sub.add_parser("logs", help="Live log tail")
    log_p.add_argument("service", nargs="?", default="lnd",
                       help="Service: lnd, bitcoind, btcpayserver, nbxplorer, nginx, mercury-agent")

    pay_p = sub.add_parser("pay", help="Send a Lightning payment")
    pay_p.add_argument("bolt11", help="BOLT11 invoice string")

    inv_create_p = sub.add_parser("invoice", help="Create a Lightning invoice")
    inv_create_p.add_argument("sat", type=int, help="Amount in satoshis")
    inv_create_p.add_argument("memo", nargs="?", default="", help="Optional memo")

    magma_p = sub.add_parser("magma", help="Magma liquidity intelligence")
    magma_p.add_argument("subcmd", nargs="?", default="offers",
                         choices=["offers", "score", "recommend"],
                         help="offers (default), score, recommend")
    magma_p.add_argument("--min", type=int, default=100000, dest="min_sat", metavar="SAT")
    magma_p.add_argument("--max", type=int, default=5000000, dest="max_sat", metavar="SAT")

    ask_p = sub.add_parser("ask", help="Ask your node anything (AI)")
    ask_p.add_argument("question", nargs="+", help="Your question in natural language")

    args = parser.parse_args()

    dispatch = {
        "status":   cmd_status,
        "channels": cmd_channels,
        "invoices": cmd_invoices,
        "sync":     cmd_sync,
        "peers":    cmd_peers,
        "backup":   cmd_backup,
        "logs":     cmd_logs,
        "pay":      cmd_pay,
        "invoice":  cmd_invoice,
        "magma":    cmd_magma,
        "ask":      cmd_ask,
        "version":  cmd_version,
        "shell":    cmd_shell,
    }

    if args.command is None:
        cmd_shell()
        return

    if args.command in dispatch:
        try:
            dispatch[args.command](args)
        except KeyboardInterrupt:
            print()
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
