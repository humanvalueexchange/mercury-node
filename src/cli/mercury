# ── Constants ─────────────────────────────────────────────────────────────────
MERCURY_VERSION = "0.4.0"
LND_DIR = "/var/lib/lnd"
LND_USER = "lnd"
AGENT_URL = "http://localhost:8088"
OLLAMA_URL = os.getenv("MERCURY_OLLAMA_URL", "http://10.0.0.79:11434")
