                print(f"  Min chan: {W}{fmt_sat(int(min_ch))}{NC}")
        else:
            print(f"  Graph:    {Y}Not yet visible — channel pending confirmation{NC}")
            print(f"  {DIM}{data.get('note', '')}{NC}")
            print(f"  {DIM}amboss.space/node/{data.get('pubkey', '')}{NC}")

